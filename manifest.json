{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.6",
  "description": "__MSG_extensionDescription__",
  "default_locale": "ja",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
